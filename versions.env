# versions.env
# =============================================================================
# Pinned base-service / mock image tags for docker-compose.consumer-test.yml —
# the bounded local-up nightly-integration.yml stands up for the nightly
# integration suite (governance/local-environment.md "Detection contract").
#
# VERSION PARITY: these mirror the versions FuzeInfra runs, sourced from the
# vendored submodule's `FuzeInfra/docker-compose.FuzeInfra.yml` (the
# version-parity source of truth — do NOT hand-pick a drifting tag). To
# refresh after a FuzeInfra version bump: diff that file's `image:` lines and
# update the values below (and the matching `${VAR:-default}` fallback in
# docker-compose.consumer-test.yml, which must stay in sync so `docker compose
# config` still renders cleanly with no --env-file at all).
#
# Loaded via `--env-file versions.env` — optional per the detection contract
# (nightly-integration.yml does `[ -f "$dir/versions.env" ] && envf=(--env-file
# "$dir/versions.env")`), so its absence is never a failure mode, only a
# fallback to the inline defaults in the compose file.

POSTGRES_TAG=15
MAILHOG_TAG=v1.0.1
STRIPE_MOCK_TAG=latest
MOCK_LLM_TAG=main-stable
