node_modules/

# SSH Keys and sensitive files
keys/
*.pem
*.key

# Environment files — never commit real secrets. Use the .env.example templates.
.env
**/.env
!.env.example
!**/.env.example

# Playwright artifacts
**/test-results/
**/playwright-report/
# The prod / post-prod configs write to their own suffixed dirs (outputDir +
# html reporter outputFolder), which the bare patterns above do not cover.
**/test-results-prod/
**/playwright-report-prod/
**/test-results-post-prod/
**/playwright-report-post-prod/
frontend/screens/

# Downloaded CLI tools / binaries (never commit — re-downloadable)
/cloudflared
/cloudflared.deb
/mkcert
*.deb

# Local agent tooling / throwaway captures
AGENTS.md
frontend/tests/_screens.spec.ts

# Local dev CA public cert (per-machine; regenerate via deploy/local-tls/)
deploy/local-tls/*.crt

# Isolated per-worktree npm caches (parallel-agent gotcha)
.npm-cache/
.npm-cache-*/

# Build output for the @fuzefront/* npm packages (regenerated by `npm run build`)
packages/*/dist/
# EXCEPTION: @izzywdev/fuzefront-identity's dist IS tracked, same as shared/dist.
# It is consumed by a STATIC typed import in backend, backend/security and
# backend/applications; their `tsc --noEmit` type-check and ts-jest resolve its
# types via the node_modules workspace symlink -> dist/index.d.ts. CI does not
# build packages/ before those checks (only Docker does), so an untracked dist
# is absent there and every consumer fails with TS2307. Committing it is the
# same trade-off shared/dist already makes. Rebuild with `npm run build -w
# @izzywdev/fuzefront-identity` after changing packages/identity/src.
!packages/identity/dist/

# chat-service build output. Regenerated by `npm run -w @fuzefront/chat-service build`
# and baked in the image's build stage, so it is never committed. Listed explicitly
# rather than as services/*/dist/ because email-service's dist IS tracked.
services/chat-service/dist/

# notification-service build output. Same reasoning as chat-service above:
# regenerated by `npm run -w @fuzefront/notification-service build` and baked in
# the image's build stage, so it is never committed.
services/notification-service/dist/

# selection-list-service build output. Same reasoning as chat-service above.
services/selection-list-service/dist/

# Per-package local .npmrc workarounds (Windows native-binary installs only;
# the repo's os=linux pin must NOT be overridden in CI).
packages/*/.npmrc

# Stray npm pack tarballs
*.tgz

# Per-package lockfiles (generated locally; CI installs fresh).
packages/*/package-lock.json

# Android TWA keystore binary — store as base64 in ANDROID_KEYSTORE_B64 GitHub Secret
android/keystore/*.keystore
android/keystore/*.jks
# Bubblewrap-generated Android project (reproducible via `bubblewrap init`)
android/app/
android/gradle/

# Shopify Navigator (standalone unit) — same rules, SHOPIFY_NAV_* GitHub Secrets
shopify-nav/android/keystore/
shopify-nav/android/app/
shopify-nav/android/gradle/
shopify-nav/android/*.keystore
shopify-nav/deploy/.env
shopify-nav/server/data/
android/gradlew
android/gradlew.bat
android/build.gradle
android/settings.gradle
android/local.properties

# Vite build output (generated; not committed)
frontend/dist/
.claude/worktrees/
__pycache__/

# design-frames Pages build output
_site/
_site_test/

# Claude Code personal/session settings (not committed)
.claude/settings.local.json

# Local dev/test database file. `backend/scripts/init-db.js` (npm run db:init)
# writes this whenever the run is not pointed at Postgres, so anyone who
# reproduces a CI failure locally generates one. A database binary must never
# be committed: it churns on every run and can carry real data.
backend/database.sqlite
