{
  "name": "@fuzefront/config-service",
  "version": "1.0.0",
  "private": true,
  "description": "Namespaced, hierarchical configuration service for FuzeFront \u2014 catalog, values, and the scope-chain resolution engine (FF-EPIC-17)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@izzywdev/fuzefront-identity": "file:../../packages/identity",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
