    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "nodemon": "3.0.1",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.1.6"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
