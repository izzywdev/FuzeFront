{
  "name": "@fuzeone/notification-service",
  "version": "1.0.0",
  "description": "Notification microservice for FuzeFront — inbox, preferences, SSE delivery",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "migrate": "knex --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:make": "knex --knexfile src/db/knexfile.ts migrate:make"
  },
  "dependencies": {
    "express": "4.19.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "nodemon": "3.0.1",
    "supertest": "6.3.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.1.6"
  }
}
