# Build byproduct — regenerated by `node build.mjs` whenever esbuild is
# resolvable (e.g. pulled in transitively by vite for harness/vitest dev
# deps). Not part of the published package ("files" in package.json).
_ds_bundle.js

# Local dev/test dependencies for this workspace (see package.json).
node_modules/

# This workspace's dependencies are resolved through the monorepo ROOT
# package-lock.json (npm workspaces) — a nested lockfile here diverges from
# it and is exactly what broke `npm ci` at the root (missing packages).
# Do a local `npm install` here only for quick iteration; never commit its
# lockfile.
package-lock.json
