{
  "name": "@fuzefront/auth-ui",
  "version": "0.1.0",
  "description": "Reusable sign-in / sign-up AuthPanel UI for FuzeFront, on the fuse-seam design system — React component + zero-dep vanilla mount",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./vanilla": { "default": "./dist/auth-ui.vanilla.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node esbuild.vanilla.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@fuzefront/design-system": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fuzefront/design-system": "1.0.0",
    "@fuzefront/security-client": "0.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "restricted" },
  "repository": { "type": "git", "url": "https://github.com/fuzefront/FuzeFront.git", "directory": "packages/auth-ui" }
}
