          "aggregateVersion": 2,
          "kind": "updated",
          "data": {
            "name": "x"
          }
        }
      ],
      "expectedOutcomes": [
        "applied",
        "applied",
        "ignored"
      ],
      "expectedFinalState": {
        "org_01h455vb4pex5vsknk084sn02q": {
          "version": 2,
          "deleted": false,
          "data": {
            "name": "b"
          }
        }
      }
    },
    {
      "name": "newer-applied-with-gap",
      "description": "a gap in versions is fine: newer wins",
      "events": [
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn02q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
