{
  "description": "Aggregate version guard (standard section 4.2). Per aggregateId the consumer keeps {version, deleted, data}. An event is applied iff aggregateVersion > stored version (strictly); otherwise ignored. `created`/`updated` set data to the event snapshot; `deleted` sets deleted=true and data=null and KEEPS the version as a tombstone, so a late lower-version event can never resurrect it. Events are delivered in array order. All eventIds are distinct (dedupe is a separate vector set).",
  "semantics": {
    "outcomes": [
      "applied",
      "ignored"
    ],
    "initialState": "no row (version 0)"
  },
  "cases": [
    {
      "name": "in-order",
      "description": "created v1, updated v2, updated v3",
      "events": [
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn02q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 1,
          "kind": "created",
          "data": {
            "name": "a"
          }
        },
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn03q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 2,
          "kind": "updated",
          "data": {
            "name": "b"
          }
        },
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn04q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 3,
          "kind": "updated",
          "data": {
            "name": "c"
          }
        }
      ],
      "expectedOutcomes": [
        "applied",
        "applied",
        "applied"
      ],
      "expectedFinalState": {
        "org_01h455vb4pex5vsknk084sn02q": {
          "version": 3,
          "deleted": false,
          "data": {
            "name": "c"
          }
        }
      }
    },
    {
      "name": "older-ignored",
      "description": "an updated v2 arriving after v3 is ignored",
      "events": [
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn02q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 1,
          "kind": "created",
          "data": {
            "name": "a"
          }
        },
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn04q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 3,
          "kind": "updated",
          "data": {
            "name": "c"
          }
        },
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn03q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 2,
          "kind": "updated",
          "data": {
            "name": "b"
          }
        }
      ],
      "expectedOutcomes": [
        "applied",
        "applied",
        "ignored"
      ],
      "expectedFinalState": {
        "org_01h455vb4pex5vsknk084sn02q": {
          "version": 3,
          "deleted": false,
          "data": {
            "name": "c"
          }
        }
      }
    },
    {
      "name": "equal-ignored",
      "description": "a different event carrying an already-applied version is ignored",
      "events": [
        {
          "eventId": "evt_01h455vb4pex5vsknk084sn02q",
          "aggregateId": "org_01h455vb4pex5vsknk084sn02q",
          "aggregateVersion": 1,
          "kind": "created",
          "data": {
