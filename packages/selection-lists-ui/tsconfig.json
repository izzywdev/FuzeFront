{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@fuzefront/design-system": ["../../design-system/index.d.ts", "../../design-system"],
      "@fuzefront/design-system/*": ["../../design-system/*"],
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"],
      "@vitest/expect": ["./node_modules/@vitest/expect"],
      "@vitest/expect/*": ["./node_modules/@vitest/expect/*"]
    },
    "baseUrl": "."
  },
  "include": ["src"]
}
