{
  "name": "@izzywdev/fuzefront-events",
  "version": "0.1.0",
  "description": "Event envelope v2 builder, transactional outbox, relay and idempotent consumer runtime (data-consistency standard §3-§4)",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "default": "./dist/testkit/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testkit": [
        "./dist/testkit/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "npm run --prefix ../../shared build:kafka && npm run --prefix ../identity build",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izzywdev/FuzeFront.git",
    "directory": "packages/events"
  },
  "dependencies": {
    "@fuzefront/shared": "^1.3.0",
    "@izzywdev/fuzefront-identity": "^1.2.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.4",
    "jest": "29.7.0",
    "kafkajs": "2.2.4",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "ts-jest": "29.1.1",
    "typescript": "^5.0.0"
  }
}
