{
  "manifestVersion": "1",
  "slug": "myapp",
  "name": "MyApp",
  "menuLabel": "MyApp",
  "description": "One line describing what this product does, shown in the app launcher.",
  "icon": {
    "kind": "emoji",
    "value": "\ud83d\udce6"
  },
  "mode": "portal",
  "modes": [
    "portal",
    "standalone"
  ],
  "builtin": false,
  "integration": {
    "type": "module-federation",
    "remoteEntry": "/apps/myapp/assets/remoteEntry.js",
    "scope": "myappApp",
    "module": "./MyApp"
  },
  "nav": {
    "section": "build",
    "order": 10
  },
  "chrome": {
    "menu": "host",
    "topbar": "host"
  },
  "routing": {
    "path": "/app/myapp",
    "host": "myapp.fuzefront.com"
  },
  "distribution": {
    "appleAppStoreUrl": "https://apps.apple.com/app/id123456789",
    "googlePlayUrl": "https://play.google.com/store/apps/details?id=com.example.myapp",
    "apkUrl": "https://github.com/example/myapp/releases/latest/download/myapp-android-latest.apk"
  },
  "visibility": "organization",
  "roles": []
}
